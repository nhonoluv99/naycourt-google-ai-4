rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isServerAdmin() {
      return isAuthenticated() && request.auth.token.email == 'nhonoluv99@gmail.com';
    }

    // Single active tournament per user
    match /tournaments/{userId} {
      allow get: if isOwner(userId) || isServerAdmin();
      allow list: if isServerAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update: if (isOwner(userId) && request.resource.data.userId == request.auth.uid) || isServerAdmin();
      allow delete: if isOwner(userId) || isServerAdmin();
    }

    // Multiple saved tournaments per user ("Giải đấu của tôi")
    match /user_tournaments/{tournamentId} {
      allow get: if isServerAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isServerAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isServerAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // User tracking for host / admin
    match /users/{userId} {
      allow get: if isOwner(userId) || isServerAdmin();
      allow list: if isServerAdmin();
      allow create, update: if isOwner(userId) || isServerAdmin();
      allow delete: if isServerAdmin();
    }

    // Activity and access audit logs for host / admin
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, list: if isServerAdmin();
      allow update, delete: if isServerAdmin();
    }
  }
}
